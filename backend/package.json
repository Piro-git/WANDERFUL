{
  "name": "trailmind-intent-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "start:local": "node --env-file=.env scripts/start-local.js",
    "test": "node --test",
    "test:postgres-integration": "node --test --test-concurrency=1 test/outdoorEvidencePostgisIntegration.test.js test/outdoorResearchOsmProjectionPostgisIntegration.test.js test/outdoorResearchExecutorPostgisIntegration.test.js test/outdoorResearchPostgisIntegration.test.js test/postgresAppAttestIntegration.test.js",
    "build": "node --check api/*.js evaluation/outdoorAdventureQuality/*.js evaluation/outdoorAdventureServerLiveProof/*.js evaluation/outdoorAdventureStagingProof/*.js scripts/*.js src/*.js src/appAttest/*.js src/outdoorAdventure/*.js src/outdoorEvidence/*.js src/outdoorResearch/*.js src/routeResearch/*.js src/routing/*.js test/*.js",
    "eval:outdoor-adventure-quality": "node scripts/run-outdoor-adventure-quality-eval.js",
    "eval:outdoor-adventure-staging-proof": "node scripts/run-outdoor-adventure-staging-proof.js",
    "eval:outdoor-adventure-server-live-proof": "node scripts/run-outdoor-adventure-server-live-proof.js",
    "db:migrate": "node scripts/migrate.js",
    "outdoor-evidence:import": "node scripts/import-outdoor-evidence.js",
    "outdoor-research:configure-osm-policy": "node scripts/configure-osm-outdoor-research-policy.js",
    "outdoor-research:project-osm": "node scripts/project-osm-outdoor-research.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "asn1js": "3.0.7",
    "cbor-x": "1.6.4",
    "pg": "8.22.0",
    "pkijs": "3.4.0"
  }
}
