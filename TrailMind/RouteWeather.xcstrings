{
  "sourceLanguage": "en",
  "strings": {
    "Weather along your route": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wetter entlang deiner Route"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weather along your route"
          }
        }
      }
    },
    "Plan your layers and breaks with a forecast for points along this route.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plane Kleidung und Pausen mit einer Prognose für mehrere Punkte deiner Route."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan your layers and breaks with a forecast for points along this route."
          }
        }
      }
    },
    "Time and forecast details": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeit und Wetterdetails"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time and forecast details"
          }
        }
      }
    },
    "Planned start": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geplanter Start"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Planned start"
          }
        }
      }
    },
    "Times shown in %@ (device time zone).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitangaben in %@ (Zeitzone des Geräts)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Times shown in %@ (device time zone)."
          }
        }
      }
    },
    "The window uses the mapped route duration without breaks. Three samples cannot describe every trail section. Forecasts can change, especially in mountains; check official warnings before setting off.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zeitfenster basiert auf der berechneten Routendauer ohne Pausen. Drei Punkte bilden nicht jeden Wegabschnitt ab. Prognosen können sich besonders im Gebirge ändern. Prüfe vor dem Start offizielle Warnungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The window uses the mapped route duration without breaks. Three samples cannot describe every trail section. Forecasts can change, especially in mountains; check official warnings before setting off."
          }
        }
      }
    },
    "Start": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Start"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start"
          }
        }
      }
    },
    "Finish": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziel"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish"
          }
        }
      }
    },
    "Halfway along the route": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf halber Strecke"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Halfway along the route"
          }
        }
      }
    },
    "Forecast interval: %d h": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prognoseintervall: %d Std."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forecast interval: %d h"
          }
        }
      }
    },
    "Model updated %@ · retrieved %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellstand %@ · abgerufen %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model updated %@ · retrieved %@"
          }
        }
      }
    },
    "Precipitation is the highest interval average, including rain or snow, not a peak intensity or a trip total. Wind is modelled near the ground, not gusts. Values are summarized across the trip window.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niederschlag ist der höchste Intervallmittelwert für Regen oder Schnee, keine Spitzenintensität oder Gesamtmenge der Tour. Wind bezeichnet den bodennahen Modellwind, keine Böen. Die Werte fassen das gesamte Zeitfenster zusammen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Precipitation is the highest interval average, including rain or snow, not a peak intensity or a trip total. Wind is modelled near the ground, not gusts. Values are summarized across the trip window."
          }
        }
      }
    },
    "Data license · CC BY 4.0": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datenlizenz · CC BY 4.0"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data license · CC BY 4.0"
          }
        }
      }
    },
