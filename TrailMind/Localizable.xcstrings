    "Water treatment supplies" : {"localizations": {"de": {"stringUnit": {"state": "translated", "value": "Ausrüstung zur Wasseraufbereitung"}}}},
    "If collecting water, choose a suitable method." : {"localizations": {"de": {"stringUnit": {"state": "translated", "value": "Falls du Wasser sammelst, wähle eine passende Aufbereitung."}}}},
    "Food & spare snacks" : {"localizations": {"de": {"stringUnit": {"state": "translated", "value": "Verpflegung & zusätzliche Snacks"}}}},
    "Allow for delays as well as your planned outing." : {"localizations": {"de": {"stringUnit": {"state": "translated", "value": "Plane auch einen Vorrat für Verzögerungen ein."}}}},
    "Map & navigation backup" : {"localizations": {"de": {"stringUnit": {"state": "translated", "value": "Karte & Ersatz zur Orientierung"}}}},
