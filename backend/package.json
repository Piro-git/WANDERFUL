{
  "name": "trailmind-intent-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/operations/start.js",
    "start:local": "node --env-file=.env scripts/start-local.js",
    "test": "node --test",
    "test:postgres-integration": "node --test --test-concurrency=1 test/outdoorEvidencePostgisIntegration.test.js test/outdoorResearchOsmProjectionPostgisIntegration.test.js test/outdoorResearchExecutorPostgisIntegration.test.js test/outdoorResearchPostgisIntegration.test.js test/postgresAppAttestIntegration.test.js",
    "build": "node --check api/*.js evaluation/outdoorAdventureQuality/*.js evaluation/outdoorAdventureServerLiveProof/*.js evaluation/outdoorAdventureStagingProof/*.js evaluation/outdoorAdventureTargetedLiveRouteQualityProofV4/*.js scripts/*.js scripts/disposable/*.js scripts/staging/*.js scripts/staging-prerequisites-v3/*.js src/*.js src/appAttest/*.js src/operations/*.js src/operations/stagingPrerequisitesV3/*.js src/outdoorAdventure/*.js src/outdoorEvidence/*.js src/outdoorResearch/*.js src/routeResearch/*.js src/routing/*.js test/*.js",
    "eval:outdoor-adventure-quality": "node scripts/run-outdoor-adventure-quality-eval.js",
    "eval:outdoor-adventure-staging-proof": "node scripts/run-outdoor-adventure-staging-proof.js",
    "eval:outdoor-adventure-server-live-proof": "node scripts/run-outdoor-adventure-server-live-proof.js",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:historical-portable-v1": "TRAILMIND_MIGRATION_POLICY=historical-portable-v1 node scripts/migrate.js",
    "db:migrate:supabase-postgis-isolation-v2": "node scripts/staging/phase1-v2-operator.js",
    "db:migrate:supabase-postgis-isolation-v2:preflight": "node scripts/staging/phase1-v2-operator.js --preflight-only",
    "test:supabase-postgis-isolation-v2": "node scripts/disposable/run-supabase-postgis-isolation-v2.js && node scripts/disposable/run-staging-phase1-v2-single-session-adapter.js",
    "test:production-observer-auditor-postgres": "node scripts/disposable/run-staging-phase1-v2-production-auditor.js",
    "ops:preflight": "node src/operations/preflight.js",
    "ops:prune-app-attest": "node src/appAttest/pruneExpired.js",
    "ops:validate-release-package": "node src/operations/validateReleasePackage.js",
    "outdoor-evidence:import": "node scripts/import-outdoor-evidence.js",
    "outdoor-evidence:retire-generation": "node scripts/retire-outdoor-evidence-generation.js",
    "outdoor-research:configure-osm-policy": "node scripts/configure-osm-outdoor-research-policy.js",
    "outdoor-research:project-osm": "node scripts/project-osm-outdoor-research.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "asn1js": "3.0.7",
    "cbor-x": "1.6.4",
    "pg": "8.22.0",
    "pkijs": "3.4.0"
  }
}
