// Safe default for fresh checkouts. Local.xcconfig is optional and gitignored.
INTENT_BACKEND_BASE_URL = http:/$()/127.0.0.1:3000
PRODUCTION_BACKEND_BASE_URL = https:/$()/backend-zeta-amber-69.vercel.app
// Optional post-routing outdoor evidence is release-gated and opt-in.
OUTDOOR_EVIDENCE_ENABLED = false
// Research-guided orchestration is an iOS-only seam and remains opt-in.
RESEARCH_GUIDED_PLANNING_ENABLED = false
// Routable highlight access uses the strict orchestration V2 contract.
ROUTABLE_HIGHLIGHT_ACCESS_ENABLED = false
// Superwall uses a public SDK key, but keep environment-specific values local.
SUPERWALL_API_KEY =
// Hiking-profile sync is local-only and non-activatable in V1.
SUPABASE_ONBOARDING_SYNC_ENABLED = false
// Reserved public-client fields remain blank in tracked configuration.
SUPABASE_PROJECT_URL =
SUPABASE_PUBLISHABLE_KEY =
#include? "Local.xcconfig"
