    "Add only the defaults that make planning easier. You can leave every answer unknown." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Lege nur fest, was dir die Planung erleichtert. Du kannst jede Antwort offenlassen." } } } },
    "Choose your places. Wanderful will check them before calculating a route." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Wähle deine Orte. Wanderful prüft sie, bevor eine Route berechnet wird." } } } },
