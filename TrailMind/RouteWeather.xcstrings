        }
      }
    },
    "Choose trip time": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startzeit auswählen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose trip time"
          }
        }
      }
    },
    "Checking three points along the route…": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei Punkte entlang der Route werden geprüft …"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking three points along the route…"
          }
        }
      }
    },
    "Weather could not be loaded. Check your connection and try again; your route is unchanged.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wetter konnte nicht geladen werden. Prüfe deine Verbindung und versuche es erneut. Deine Route bleibt erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weather could not be loaded. Check your connection and try again; your route is unchanged."
          }
        }
      }
    },
    "Check the forecast for your planned start.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe die Prognose für deinen geplanten Start."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the forecast for your planned start."
          }
        }
      }
    },
    "Choose a start date and time in the details to see your route forecast.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle in den Details ein Startdatum und eine Uhrzeit für deine Wettervorschau."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a start date and time in the details to see your route forecast."
          }
        }
      }
    },
    "This forecast needs a fresh check.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Prognose muss aktualisiert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This forecast needs a fresh check."
          }
        }
      }
    },
    "This trip window is outside the available forecast. Choose a future start within about nine days and check again closer to departure.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Zeitfenster liegt außerhalb der verfügbaren Prognose. Wähle einen zukünftigen Start innerhalb von etwa neun Tagen und prüfe das Wetter kurz vor der Tour erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This trip window is outside the available forecast. Choose a future start within about nine days and check again closer to departure."
          }
        }
      }
    },
    "Weather previews cover routes up to 24 hours. Check each day separately for a longer trip.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wettervorschauen decken Routen bis 24 Stunden ab. Prüfe bei längeren Touren das Wetter für jeden Tag separat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weather previews cover routes up to 24 hours. Check each day separately for a longer trip."
          }
        }
      }
    },
    "Weather is currently unavailable for this route. Please try again later and consult a local forecast.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Route ist gerade keine Wettervorschau verfügbar. Versuche es später erneut und prüfe eine lokale Prognose."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weather is currently unavailable for this route. Please try again later and consult a local forecast."
          }
        }
      }
    },
