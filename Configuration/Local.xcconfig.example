// Copy this example to Configuration/Local.xcconfig without opening an
// existing Local.xcconfig. The destination is gitignored and Development-only.
// Never commit Local.xcconfig or place production/staging values in it.

// Optional local backend. Only exact loopback HTTP is accepted.
// LOCAL_BACKEND_BASE_URL = http:/$()/127.0.0.1:3000

// Provider/research flags are protected false by Development.xcconfig. No
// GraphHopper, Supabase, AI, or private key belongs in this file.

// Superwall uses a public SDK key, but its flag remains protected false and
// onboarding remains native in V1.
// LOCAL_SUPERWALL_PUBLIC_SDK_KEY = pk_public_placeholder

// Optional public web pages. The app accepts only canonical public HTTPS URLs
// and always keeps native Privacy & data and Help & safety pages available.
// Leave these unset until the product owner supplies reviewed public URLs.
// In xcconfig, // begins a comment. Preserve the second HTTPS slash with the
// empty-substitution form https:/$()/… when a reviewed value is supplied.
// Do not add placeholder destinations.
// LOCAL_PRIVACY_POLICY_URL =
// LOCAL_TERMS_OF_USE_URL =
// LOCAL_SUPPORT_URL =

// StoreKit product identifiers are owner-provided public values. Keep them
// unset until matching App Store Connect subscriptions and reviewed legal
// pages exist. Development keeps MONETIZATION_ENABLED protected false; use the
// test-only StoreKit scheme scenario for local purchase QA.
// LOCAL_PREMIUM_MONTHLY_PRODUCT_ID =
// LOCAL_PREMIUM_ANNUAL_PRODUCT_ID =
