  "invariants": [
    {
      "id": "flag-invariant-unknown-false",
      "rule": "Unknown, missing, empty, or malformed deployed boolean values never enable a capability."
    },
    {
      "id": "flag-invariant-backend-before-client",
      "rule": "A backend gate is enabled and proved before the matching iOS gate is distributed."
    },
    {
      "id": "flag-invariant-access-requires-research",
      "rule": "Routable highlight access V2 cannot be true unless research planning is true on the same surface and the backend access gate is true."
    },
    {
      "id": "flag-invariant-provider-upstream-gates",
      "rule": "Provider work is forbidden when any phase-required security, research, access, authorization, budget, or freshness gate is false."
    },
    {
      "id": "flag-invariant-release-false-until-go",
      "rule": "Release/client ordinary flags remain false until every mandatory GO item has evidence and explicit approval."
    },
    {
      "id": "flag-invariant-proof-cleanup",
      "rule": "Physical and V4 proof flags return to false after execution, failure, cancellation, or timeout."
    },
    {
      "id": "flag-invariant-insecure-never-beta",
      "rule": "Insecure routing/parsing/research, deterministic mock, and in-memory App Attest flags are always false in staging proofs and closed beta."
    },
    {
      "id": "flag-invariant-intent-provider-off",
      "rule": "The remote intent provider remains false because the declared Release parser is local and remote intent is outside this beta."
    },
    {
      "id": "flag-invariant-production-preflight",
      "rule": "Production admission requires every controlled backend flag to be present as exact true or false; insecure/local/in-memory/mock flags are exact false, and malformed values block startup."
    }
  ]
