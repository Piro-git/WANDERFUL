    "Phone & backup power" : {"localizations": {"de": {"stringUnit": {"state": "translated", "value": "Handy & Powerbank"}}}},
    "Charge before leaving." : {"localizations": {"de": {"stringUnit": {"state": "translated", "value": "Lade alles vor dem Aufbruch auf."}}}},
    "Headlamp & spare power" : {"localizations": {"de": {"stringUnit": {"state": "translated", "value": "Stirnlampe & Ersatzakku"}}}},
    "Delays can extend into darkness." : {"localizations": {"de": {"stringUnit": {"state": "translated", "value": "Bei Verzögerungen kann es unterwegs dunkel werden."}}}},
    "First aid & personal medication" : {"localizations": {"de": {"stringUnit": {"state": "translated", "value": "Erste Hilfe & persönliche Medikamente"}}}},
    "Check supplies and expiry dates." : {"localizations": {"de": {"stringUnit": {"state": "translated", "value": "Prüfe Inhalt und Haltbarkeit."}}}},
    "Emergency blanket or bivy" : {"localizations": {"de": {"stringUnit": {"state": "translated", "value": "Rettungsdecke oder Notbiwaksack"}}}},
    "Emergency cover, separate from camping equipment." : {"localizations": {"de": {"stringUnit": {"state": "translated", "value": "Schutz für Notfälle, zusätzlich zur Campingausrüstung."}}}},
    "Small repair kit" : {"localizations": {"de": {"stringUnit": {"state": "translated", "value": "Kleines Reparaturset"}}}},
    "Choose tools for your equipment." : {"localizations": {"de": {"stringUnit": {"state": "translated", "value": "Wähle Werkzeug passend zu deiner Ausrüstung."}}}},
    "Emergency fire kit" : {"localizations": {"de": {"stringUnit": {"state": "translated", "value": "Feuerstarter für Notfälle"}}}},
    "Check local fire restrictions; carrying a kit is not permission to light fires." : {"localizations": {"de": {"stringUnit": {"state": "translated", "value": "Prüfe örtliche Feuerverbote. Ein Feuerstarter ist keine Erlaubnis, Feuer zu machen."}}}},
    "A meal for the longer outing" : {"localizations": {"de": {"stringUnit": {"state": "translated", "value": "Mahlzeit für die längere Tour"}}}},
    "Make room for a meal in your food plan." : {"localizations": {"de": {"stringUnit": {"state": "translated", "value": "Plane eine Mahlzeit in deine Verpflegung ein."}}}},
    "Dry change & spare socks" : {"localizations": {"de": {"stringUnit": {"state": "translated", "value": "Trockene Wechselkleidung & Ersatzsocken"}}}},
    "Keep sleeping clothes dry." : {"localizations": {"de": {"stringUnit": {"state": "translated", "value": "Halte deine Kleidung für die Nacht trocken."}}}},
    "Overnight meals & toiletries" : {"localizations": {"de": {"stringUnit": {"state": "translated", "value": "Verpflegung für die Nacht & Hygieneartikel"}}}},
    "Plan each meal and personal supplies." : {"localizations": {"de": {"stringUnit": {"state": "translated", "value": "Plane alle Mahlzeiten und deinen persönlichen Bedarf."}}}},
    "Tent & pitching kit" : {"localizations": {"de": {"stringUnit": {"state": "translated", "value": "Zelt & Zubehör zum Aufbau"}}}},
    "Check equipment and permitted places to stay." : {"localizations": {"de": {"stringUnit": {"state": "translated", "value": "Prüfe deine Ausrüstung und erlaubte Übernachtungsplätze."}}}},
