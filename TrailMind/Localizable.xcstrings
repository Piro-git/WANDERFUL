    "Skip personalization" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Personalisierung überspringen" } } } },
    "Town, valley or trailhead" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Ort, Tal oder Wanderparkplatz" } } } },
    "Your trail shelf" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Deine gespeicherten Routen" } } } },
    "Your usual day" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Dein üblicher Tag" } } } },
    "A reported restriction affects this route. Review the notice before setting off." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Eine gemeldete Einschränkung betrifft diese Route. Lies den Hinweis vor dem Aufbruch." } } } },
    "Access connection is unconfirmed. Check local signs and rules." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Verbindung zum Zugang ist nicht bestätigt. Prüfe lokale Beschilderung und Regeln." } } } },
    "Current local conditions have not been checked for this route." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Die aktuellen Bedingungen vor Ort wurden für diese Route nicht geprüft." } } } },
    "Day hike is the starting list. Change this to match your plans." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Tageswanderung ist die Ausgangsliste. Passe sie an deine Tour an." } } } },
    "Discard unreadable local record" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Nicht lesbaren lokalen Eintrag verwerfen" } } } },
    "Discard unreadable record" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Nicht lesbaren Eintrag verwerfen" } } } },
    "Dismiss" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Schließen" } } } },
    "Follow the mapped route" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Der kartierten Route folgen" } } } },
    "GPS can follow the saved line without internet. There is no offline route recalculation or AI planning. Prepare another reliable map before leaving coverage." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "GPS kann der gespeicherten Linie ohne Internet folgen. Offline gibt es keine Neuberechnung und keine KI-Planung. Bereite vor dem Verlassen des Empfangsbereichs eine weitere zuverlässige Karte vor." } } } },
    "Loading App Store options…" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "App-Store-Optionen werden geladen …" } } } },
    "Manage subscription" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Abo verwalten" } } } },
    "No mapped routing instruction is available here. Check the map and local signs." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Hier gibt es keine kartierte Weganweisung. Prüfe die Karte und lokale Schilder." } } } },
    "No relevant report was returned by the listed sources. This does not confirm that paths are open." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Die aufgeführten Quellen haben keinen passenden Hinweis geliefert. Das bestätigt nicht, dass Wege offen sind." } } } },
    "Not needed items are left out of packing progress. Restore them whenever plans change." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Nicht benötigte Gegenstände zählen nicht zum Packfortschritt. Stelle sie wieder her, wenn sich deine Pläne ändern." } } } },
    "Offline map unavailable" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Offline-Karte nicht verfügbar" } } } },
    "Offline preparation · maps not downloaded" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Offline vorbereiten · Karten nicht geladen" } } } },
    "OpenStreetMap supplies identities and positions. GraphHopper calculated the path near these stops. Current access, views, water and safety remain unconfirmed." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "OpenStreetMap liefert Namen und Positionen. GraphHopper hat den Weg nahe dieser Stopps berechnet. Zugang, Aussicht, Wasser und Sicherheit sind aktuell nicht bestätigt." } } } },
    "Preview pending" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Vorschau wird geladen" } } } },
    "Premium access verified." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Premium-Zugang bestätigt." } } } },
    "Publication date not provided." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Kein Veröffentlichungsdatum angegeben." } } } },
    "Remove unusable records" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Unbrauchbare Einträge entfernen" } } } },
    "Requested features are preferences, not verified guarantees." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Gewünschte Merkmale sind Vorlieben, keine bestätigten Zusagen." } } } },
    "Reset" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Zurücksetzen" } } } },
    "Reset answers" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Antworten zurücksetzen" } } } },
    "Reset your answers?" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Antworten zurücksetzen?" } } } },
    "Review official local notices, weather and signs before starting." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Prüfe vor dem Start offizielle Hinweise vor Ort, Wetter und Beschilderung." } } } },
    "Route preview unavailable" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Routenvorschau nicht verfügbar" } } } },
    "Saves locally first. No account needed." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Wird zuerst lokal gespeichert. Kein Konto nötig." } } } },
    "The route changed after the local search. Added areas or stops have not been checked." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Route hat sich nach der lokalen Suche geändert. Neue Bereiche oder Stopps wurden nicht geprüft." } } } },
    "The saved record can’t be read safely. Discard it to begin again. No account or network connection is required." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Der gespeicherte Eintrag kann nicht sicher gelesen werden. Verwirf ihn, um neu zu beginnen. Dafür brauchst du kein Konto und keine Internetverbindung." } } } },
    "This route has no turn instructions. Only its mapped line and route statistics can be saved." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Diese Route hat keine Abbiegehinweise. Es können nur die kartierte Linie und Routenwerte gespeichert werden." } } } },
    "Waiting for When In Use permission and a precise location." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Warte auf Standortfreigabe während der Nutzung und einen genauen Standort." } } } },
    "Your current guidance session will stop. Wanderful does not save a location track." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Deine aktuelle Routenführung wird beendet. Wanderful speichert keinen Standortverlauf." } } } },
    "Your route is ready" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Deine Route ist bereit" } } } },
    "Check the latest forecast" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Aktuelle Wettervorhersage prüfen" } } } },
    "Comfort measured by" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Komfort gemessen an" } } } },
    "Delete all saved routes" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Alle gespeicherten Routen löschen" } } } },
    "ESTIMATED EFFORT" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "GESCHÄTZTE ANSTRENGUNG" } } } },
    "Finishing transcription…" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Transkription wird abgeschlossen …" } } } },
    "General checks · separate from your packing list. Mapped route statistics above do not confirm current conditions." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Allgemeine Prüfungen · getrennt von deiner Packliste. Die Routenwerte oben bestätigen keine aktuellen Bedingungen." } } } },
    "Good to know" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Gut zu wissen" } } } },
    "How online planning uses your request" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "So verwendet die Online-Planung deine Anfrage" } } } },
    "Local reports will be compared with this date. Check again before starting." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Lokale Hinweise werden mit diesem Datum abgeglichen. Prüfe sie vor dem Start erneut." } } } },
    "Not knowing is an answer. You can change this later." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Nicht wissen ist auch eine Antwort. Du kannst das später ändern." } } } },
    "OK" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "OK" } } } },
    "OR REQUEST UP TO THREE" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "ODER WÄHLE BIS ZU DREI" } } } },
    "Plan first. Decide after the value moment." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Plane zuerst. Entscheide erst, wenn du den Nutzen kennst." } } } },
    "Plan a route by voice" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Route per Sprache planen" } } } },
    "Preparing onboarding" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Einrichtung wird vorbereitet" } } } },
    "Preparing your route setup" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Deine Routenplanung wird vorbereitet" } } } },
    "Previous step" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Vorheriger Schritt" } } } },
    "Purchases and subscription management are handled by Apple." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Käufe und Abo-Verwaltung werden von Apple abgewickelt." } } } },
