      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wetter wird geprüft …"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking weather…"
          }
        }
      }
    },
    "Check route weather": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Routenwetter prüfen"
          }
